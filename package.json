{
  "name": "nyao-music",
  "productName": "Nyao Music",
  "version": "0.8.93",
  "description": "Единый плеер для Яндекс Музыки и YouTube Music с общей «Моей волной»",
  "author": "Takko",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/boot.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "yt-test": "node scripts/yt-test.mjs",
    "dist": "node build/windows.cjs",
    "dist:mac": "electron-builder --mac",
    "bump": "node scripts/bump.mjs",
    "test": "node --test test/*.test.js build/evs-sign.test.cjs"
  },
  "dependencies": {
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "electron": "git+https://github.com/castlabs/electron-releases.git#v44.5.1+wvcus",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.nyao.music",
    "productName": "Nyao Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "version.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon-mac.png",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nyao Music"
    },
    "artifactName": "NyaoMusic-${version}-${os}-${arch}.${ext}",
    "electronVersion": "44.5.1+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "build/evs-sign.cjs",
    "protocols": [
      {
        "name": "Nyao Music",
        "schemes": [
          "nyao"
        ]
      }
    ]
  }
}
