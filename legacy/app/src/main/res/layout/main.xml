<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp">
        <org.nyao.legacy.WavesView
            android:id="@+id/logo"
            android:layout_width="30dp"
            android:layout_height="30dp" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="Nyao"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:hint="Поиск в Яндекс Музыке"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/search"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Поиск"
            android:src="@android:drawable/ic_menu_search" />
        <ImageButton
            android:id="@+id/menu"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:contentDescription="Меню"
            android:src="@android:drawable/ic_menu_more" />
    </LinearLayout>

    <include layout="@layout/stripe" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/line"
            android:dividerHeight="1px"
            android:listSelector="@drawable/row_bg" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/mini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel2"
        android:orientation="vertical"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/miniProgress"
            style="@android:style/Widget.Holo.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp">
            <ImageView
                android:id="@+id/miniCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/miniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/miniArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/miniToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Пауза или воспроизведение"
                android:src="@android:drawable/ic_media_pause" />
            <ImageButton
                android:id="@+id/miniNext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Следующий трек"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
