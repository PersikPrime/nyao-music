<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/waveTile"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="12dp"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <org.nyao.legacy.WavesView
            android:layout_width="64dp"
            android:layout_height="64dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Моя волна"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/waveSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Яндекс Музыка"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/wavePlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_accent"
            android:contentDescription="Слушать мою волну"
            android:src="@android:drawable/ic_media_play" />
    </LinearLayout>
    <TextView
        android:id="@+id/section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:text="МНЕ НРАВИТСЯ"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
